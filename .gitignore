# ==============================================================================
# RVPF Repository .gitignore
# Covers: Unreal Engine 5 Reference Implementation, OS, IDEs & Documentation
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Unreal Engine Temporary & Generated Folders
# ------------------------------------------------------------------------------
**/Binaries/
**/Build/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/.vs/
**/.idea/
**/.vscode/

# Unreal Project Configuration & Source Files
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# Unreal Package / Build Artifacts
**/Plugins/*/Intermediate/
**/Plugins/*/Binaries/
**/rvpfDemoGame/Saved/
**/rvpfDemoGame/Intermediate/
**/rvpfDemoGame/DerivedDataCache/
**/rvpfDemoGame/Binaries/

# ------------------------------------------------------------------------------
# 2. Operating System Specific
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 3. Editors, IDEs & Documentation Tools (Obsidian, VSCode, Rider)
# ------------------------------------------------------------------------------
# Obsidian Workspace Layout (exclude local UI state, keep notes)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# JetBrains / Rider
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 4. Binary Assets & Crash Logs
# ------------------------------------------------------------------------------
*.log
*.dmp
*.crash
*.tmp
*.bak
